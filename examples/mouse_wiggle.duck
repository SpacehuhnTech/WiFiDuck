REM Gentle mouse wiggle for 5 seconds every minute, until stopped.
REM Blue while moving; normal green while resting and on Stop.
DEFAULTDELAY 0
ONSTOP LED 0 25 0
LOOP 0
LED 0 0 25
MOUSEMOVE 2 2
DELAY 218
MOUSEMOVE 2 2
DELAY 289
MOUSEMOVE 1 0
DELAY 217
MOUSEMOVE 0 -1
DELAY 259
MOUSEMOVE 0 -2
DELAY 227
MOUSEMOVE 0 -2
DELAY 313
MOUSEMOVE 1 -1
DELAY 196
MOUSEMOVE -1 0
DELAY 227
MOUSEMOVE -2 1
DELAY 272
MOUSEMOVE -3 1
DELAY 253
MOUSEMOVE -3 1
DELAY 211
MOUSEMOVE -2 1
DELAY 282
MOUSEMOVE -1 0
DELAY 298
MOUSEMOVE 1 -1
DELAY 218
MOUSEMOVE 0 -2
DELAY 224
MOUSEMOVE 0 -2
DELAY 286
MOUSEMOVE 0 -1
DELAY 271
MOUSEMOVE 1 0
DELAY 272
MOUSEMOVE 2 2
DELAY 174
MOUSEMOVE 2 2
DELAY 293
LED 0 25 0
DELAY 55000
ENDLOOP
